# Copiá este archivo a ".env" (mismo directorio) y completá los
# valores reales — NUNCA commitear el .env real.

# URL pública del backend. Sin setear (dev local de siempre):
# http://localhost:4000. Para pruebas en red, la URL pública real del
# backend detrás del túnel — ej.: VITE_API_URL=https://api.tudominio.com
VITE_API_URL=

# Hostname(s) por los que Vite va a aceptar requests, separados por
# coma — sin esto, Vite rechaza el Host header del túnel (protección
# anti DNS-rebinding). Va SIN protocolo/puerto, solo el hostname —
# ej.: VITE_ALLOWED_HOSTS=app.tudominio.com
VITE_ALLOWED_HOSTS=
