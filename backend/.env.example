# Copiá este archivo a ".env" (mismo directorio) y completá los
# valores reales — NUNCA commitear el .env real, solo este ejemplo.

PORT=4000

# Postgres. En Docker Compose, DB_HOST tiene que ser el nombre del
# servicio ("db"), no "localhost" — ver docker-compose.yml.
DB_USER=
DB_HOST=localhost
DB_PASSWORD=
DB_NAME=all_bim
DB_PORT=5432

# Secretos de JWT — generá los tuyos (ej. openssl rand -hex 32),
# nunca reuses los de otro entorno.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firma de URLs temporales para /files/:id/content|thumbnail — secreto
# propio, NO reusar JWT_SECRET (así se puede rotar sin invalidar
# sesiones). TTL en segundos: cuánto dura una URL firmada antes de
# vencer (300 = 5 min).
FILE_SIGNING_SECRET=
FILE_SIGNED_URL_TTL_SECONDS=300

# Envío de emails (invitaciones) vía Resend (resend.com).
RESEND_EMAIL=
RESEND_API_KEY=

# URL PÚBLICA del frontend — se usa en los links de los emails de
# invitación. En dev local: http://localhost:5173. Si esto corre
# detrás de un túnel (Cloudflare Tunnel u otro), tiene que ser la URL
# pública real (ej. https://app.tudominio.com) — si no, los links de
# los emails van a apuntar a un localhost que nadie externo puede abrir.
DOMAIN_FRONT=http://localhost:5173

# Orígenes extra permitidos por CORS, separados por coma — además de
# los localhost de siempre (5173/5174), que SIEMPRE están permitidos
# sin que haga falta tocar esto. Solo hace falta setear esto para
# pruebas en red (frontend detrás de un túnel/dominio propio) — ej.:
# ALLOWED_ORIGINS=https://app.tudominio.com
ALLOWED_ORIGINS=

UPLOADS_DIR=uploads

# Ruta al intérprete de Python del venv de processing/ (ver
# processing/requirements.txt). En Docker, la imagen instala Python
# en la misma imagen del backend — ahí esto suele ser simplemente
# "python3" (ver backend/Dockerfile).
PROCESSING_PYTHON=/ruta/absoluta/a/processing/.venv/bin/python

# Catálogo de la norma — SÍ vive en git (processing/ifc/data/), el
# código ya usa esa ruta por defecto. Esta variable es solo para
# override puntual — dejala vacía/sin setear salvo que necesites
# apuntar a otro archivo.
NORMA_JSON_PATH=

PROCESSING_TIMEOUT_MS=600000
MAX_CONCURRENT_IFC_JOBS=2

# Solo hace falta en una BD 100% vacía (instalación nueva) — crea un
# primer usuario ADMINISTRADOR si la tabla "users" no tiene ninguno.
# En tu entorno de desarrollo de siempre (ya tiene usuarios) esto no
# hace nada, dejalo vacío tranquilo.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
