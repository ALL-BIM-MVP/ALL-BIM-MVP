  "order_date": "2026-09-29",
  "currency": "PEN",
  "items": [
    { "quotation_item_id": {{quotationItemId}}, "description": "Cemento Sol bolsa 42.5 kg (saldo)", "quantity_ordered": 40, "line_total": 1200 }
  ]
}

###
@purchaseOrder2Id = {{purchaseOrder2.response.body.$.purchase_order_id}}

