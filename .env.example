# .env para docker-compose (SOLO para levantar todo con Docker, ver
# docker-compose.yml y docs/instalacion-cliente.md). Copiá esto a
# ".env" en la RAÍZ del repo (junto a docker-compose.yml) y completá
# los valores.
#
# Para desarrollo local nativo (sin Docker, "npm run dev" a mano) NO
# es este archivo — es backend/.env.example / frontend/.env.example,
# que siguen igual que siempre.
#
# docker-compose usa este archivo para dos cosas a la vez: sustituir
# ${DB_USER} etc. en docker-compose.yml (los servicios "db"), y pasar
# TODAS estas variables tal cual al contenedor del backend
# (env_file). No hace falta copiar este archivo DENTRO de ningún
# contenedor — docker-compose lo inyecta solo.

# --- Postgres ---
# DB_HOST tiene que ser "db" (el nombre del servicio en
# docker-compose.yml, NO "localhost" — los contenedores se resuelven
# por nombre de servicio, no hay "localhost" compartido entre ellos).
DB_USER=all_bim
DB_PASSWORD=
DB_NAME=all_bim
DB_HOST=db
DB_PORT=5432

PORT=4000
# Puerto del HOST donde queda publicado el backend — normalmente igual
# a PORT (4000). Cambialo solo si el 4000 ya está ocupado por otra
# cosa en esta máquina.
BACKEND_HOST_PORT=4000

# Secretos de JWT — generá los tuyos (ej. openssl rand -hex 32).
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Firma de URLs temporales — secreto propio, no reusar JWT_SECRET.
FILE_SIGNING_SECRET=
FILE_SIGNED_URL_TTL_SECONDS=300

# Envío de emails (invitaciones) vía Resend (resend.com).
RESEND_EMAIL=
RESEND_API_KEY=

# URL pública real del frontend (detrás del túnel) — se usa en los
# links de los emails de invitación. Ej.: https://app.tudominio.com
DOMAIN_FRONT=

# Orígenes extra permitidos por CORS, separados por coma — la URL
# pública real del frontend. Ej.: https://app.tudominio.com
ALLOWED_ORIGINS=

# URL pública real del BACKEND (detrás del túnel) — se GRABA adentro
# del frontend al construir la imagen (ver frontend/Dockerfile), no es
# una variable que el contenedor lea después. Cambiarla implica
# "docker compose up -d --build frontend", no alcanza con reiniciar.
# Ej.: https://api.tudominio.com — dejar vacío mientras se prueba todo
# en la misma máquina (recién hace falta completarla al armar el túnel,
# ver docs/instalacion-cliente.md).
VITE_API_URL=

# Puerto del HOST donde queda publicado el frontend — 5173 por
# defecto, a propósito el mismo puerto que ya usa el túnel de
# Cloudflare configurado (ver docs/instalacion-cliente.md). Cambialo
# solo si el 5173 ya está ocupado por otra cosa en esta máquina.
FRONTEND_HOST_PORT=5173

UPLOADS_DIR=uploads

# Dentro del contenedor el intérprete de Python vive en el PATH del
# sistema (la imagen de backend/Dockerfile instala Python y Node
# juntos) — NO es una ruta a un venv como en desarrollo local nativo.
PROCESSING_PYTHON=python3

# Catálogo de la norma — vive en git (processing/ifc/data/), la imagen
# ya lo trae. Dejá vacío salvo que necesites apuntar a otro archivo.
NORMA_JSON_PATH=

PROCESSING_TIMEOUT_MS=600000
MAX_CONCURRENT_IFC_JOBS=2

# Primer usuario ADMINISTRADOR — obligatorio en una instalación nueva
# (BD vacía, sin seed-test.sql): sin esto no hay CÓMO entrar la
# primera vez (el registro normal necesita una invitación, y las
# invitaciones las manda alguien que ya tiene que estar logueado — ver
# docs/instalacion-cliente.md). Solo actúa UNA vez, si la tabla
# "users" está completamente vacía — no hace nada si ya hay usuarios
# (no rompe tu entorno de desarrollo si por algún motivo corrés esto
# con estas variables seteadas ahí). Cambiá la contraseña apenas
# entres la primera vez.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
